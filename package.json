{
  "name": "dsh-ui-subagent-model",
  "version": "0.1.0",
  "description": "Route every subagent to a user-chosen model: an agent/request override plus a header picker, with a prompt section telling the model what its children run on.",
  "type": "module",
  "main": "./lib/index.js",
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "homepage": "https://github.com/yuexusi/dsh-ui-subagent-model#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuexusi/dsh-ui-subagent-model.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "subagent",
    "model"
  ],
  "license": "MIT"
}
